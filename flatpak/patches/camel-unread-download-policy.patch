+static gboolean
+offline_folder_download_unread_only (CamelFolder *folder)
+{
+	CamelStore *store = camel_folder_get_parent_store (folder);
+	CamelSettings *settings;
+	gboolean unread_only = FALSE;
+
+	if (!store || camel_offline_folder_get_offline_sync (CAMEL_OFFLINE_FOLDER (folder)) != CAMEL_THREE_STATE_INCONSISTENT)
+		return FALSE;
+
+	settings = camel_service_ref_settings (CAMEL_SERVICE (store));
+	if (CAMEL_IS_OFFLINE_SETTINGS (settings) &&
+	    !camel_offline_settings_get_stay_synchronized (CAMEL_OFFLINE_SETTINGS (settings)))
+		g_object_get (settings, "download-unread-only", &unread_only, NULL);
+	g_clear_object (&settings);
+
+	return unread_only;
+}
+
+static gboolean
+offline_folder_should_download (CamelFolder *folder,
+				const gchar *uid,
+				gint64 limit_time)
+{
+	CamelMessageInfo *info;
+	gboolean download;
+	gboolean unread_only = offline_folder_download_unread_only (folder);
+
+	if (limit_time <= 0 && !unread_only)
+		return TRUE;
+
+	info = camel_folder_get_message_info (folder, uid);
+	if (!info)
+		return FALSE;
+
+	download = (limit_time <= 0 || camel_message_info_get_date_sent (info) > limit_time) &&
+		(!unread_only || !(camel_message_info_get_flags (info) & (CAMEL_MESSAGE_SEEN | CAMEL_MESSAGE_DELETED | CAMEL_MESSAGE_JUNK)));
+	g_object_unref (info);
+
+	return download;
+}

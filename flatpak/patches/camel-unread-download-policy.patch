+static void
+folder_download_unread_done_cb (GObject *source_object,
+				GAsyncResult *result,
+				gpointer user_data)
+{
+	CamelFolder *folder = CAMEL_FOLDER (source_object);
+	GError *error = NULL;
+
+	g_task_propagate_boolean (G_TASK (result), &error);
+	g_clear_error (&error);
+	g_mutex_lock (&folder->priv->change_lock);
+	folder->priv->unread_downsync_pending = FALSE;
+	g_mutex_unlock (&folder->priv->change_lock);
+}
+
+static gboolean
+folder_download_unread_allowed (CamelFolder *folder)
+{
+	CamelStore *store = camel_folder_get_parent_store (folder);
+	CamelSettings *settings;
+	CamelSession *session;
+	gboolean unread_only = FALSE;
+	gboolean online;
+
+	if (!CAMEL_IS_OFFLINE_FOLDER (folder) || !CAMEL_IS_OFFLINE_STORE (store) ||
+	    !camel_offline_store_get_online (CAMEL_OFFLINE_STORE (store)) ||
+	    !camel_offline_folder_can_downsync (CAMEL_OFFLINE_FOLDER (folder)))
+		return FALSE;
+
+	settings = camel_service_ref_settings (CAMEL_SERVICE (store));
+	g_object_get (settings, "download-unread-only", &unread_only, NULL);
+	if (camel_offline_settings_get_stay_synchronized (CAMEL_OFFLINE_SETTINGS (settings)))
+		unread_only = FALSE;
+	g_object_unref (settings);
+	if (!unread_only)
+		return FALSE;
+
+	session = camel_service_ref_session (CAMEL_SERVICE (store));
+	online = session && camel_session_get_online (session);
+	g_clear_object (&session);
+	return online;
+}
+
+static void
+folder_download_unread_thread (GTask *task,
+			      gpointer source_object,
+			      gpointer task_data,
+			      GCancellable *cancellable)
+{
+	GError *error = NULL;
+	gboolean success = TRUE;
+
+	if (folder_download_unread_allowed (CAMEL_FOLDER (source_object)))
+		success = camel_offline_folder_downsync_sync (CAMEL_OFFLINE_FOLDER (source_object),
+			"(match-all (not (system-flag \"Seen\")))", cancellable, &error);
+	if (error)
+		g_task_return_error (task, error);
+	else
+		g_task_return_boolean (task, success);
+}
+
+static void
+folder_download_unread_after_refresh (CamelFolder *folder,
+				     GCancellable *cancellable)
+{
+	GTask *task;
+
+	if (!folder_download_unread_allowed (folder))
+		return;
+
+	g_mutex_lock (&folder->priv->change_lock);
+	if (folder->priv->unread_downsync_pending) {
+		g_mutex_unlock (&folder->priv->change_lock);
+		return;
+	}
+	folder->priv->unread_downsync_pending = TRUE;
+	g_mutex_unlock (&folder->priv->change_lock);
+
+	task = g_task_new (folder, cancellable, folder_download_unread_done_cb, NULL);
+	g_task_set_priority (task, G_PRIORITY_LOW);
+	g_task_run_in_thread (task, folder_download_unread_thread);
+	g_object_unref (task);
+}

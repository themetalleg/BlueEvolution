{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "BlueEvolution: Preview Light",
      "type": "process",
      "command": "${workspaceFolder}/scripts/vscode-blueevolution.sh",
      "args": ["preview", "light"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:PATH}:/tmp/blueevolution-build-tools/usr/bin",
          "BUILD_ROOT": "${workspaceFolder}/build/flatpak-local-preview",
          "FLATPAK_STATE_DIR": "${workspaceFolder}/.flatpak-builder",
          "FLATPAK_BUILD_JOBS": "2",
          "BLUEEVOLUTION_CHANNEL": "beta",
          "BLUEEVOLUTION_VERSION": "0.2.3-dev.1"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated"
      }
    },
    {
      "label": "BlueEvolution: Preview Dark",
      "type": "process",
      "command": "${workspaceFolder}/scripts/vscode-blueevolution.sh",
      "args": ["preview", "dark"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:PATH}:/tmp/blueevolution-build-tools/usr/bin",
          "BUILD_ROOT": "${workspaceFolder}/build/flatpak-local-preview",
          "FLATPAK_STATE_DIR": "${workspaceFolder}/.flatpak-builder",
          "FLATPAK_BUILD_JOBS": "2",
          "BLUEEVOLUTION_CHANNEL": "beta",
          "BLUEEVOLUTION_VERSION": "0.2.3-dev.1"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated"
      }
    }
  ]
}

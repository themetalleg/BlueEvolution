[Desktop Entry]
_Name=@BLUEEVOLUTION_APPLICATION_NAME@
_GenericName=Groupware Suite
_X-GNOME-FullName=@BLUEEVOLUTION_APPLICATION_NAME@ Mail and Calendar
_Comment=BlueEvolution — an independent fork of GNOME Evolution with a modern, Outlook-inspired interface.
_Keywords=email;calendar;contact;addressbook;task;
Actions=new-window;compose;contacts;calendar;mail;memos;tasks;
Exec=blueevolution %U
Icon=@BLUEEVOLUTION_APP_ID@
Terminal=false
Type=Application
Categories=GNOME;GTK;Office;Email;Calendar;ContactManagement;X-Red-Hat-Base;
StartupNotify=true
X-GNOME-UsesNotifications=true
X-Flatpak-RenamedFrom=evolution
MimeType=text/calendar;text/x-vcard;text/directory;application/mbox;message/rfc822;x-scheme-handler/mailto;x-scheme-handler/mid;x-scheme-handler/webcal;x-scheme-handler/webcals;x-scheme-handler/calendar;x-scheme-handler/task;x-scheme-handler/memo;@DESKTOP_MIME_TYPES@
@WMCLASS_OVERRIDE@
[Desktop Action new-window]
_Name=New Window
Exec=blueevolution -c current

[Desktop Action compose]
_Name=Compose a Message
Exec=blueevolution mailto:

[Desktop Action contacts]
_Name=Contacts
Exec=blueevolution -c contacts

[Desktop Action calendar]
_Name=Calendar
Exec=blueevolution -c calendar

[Desktop Action mail]
_Name=Mail
Exec=blueevolution -c mail

[Desktop Action memos]
_Name=Memos
Exec=blueevolution -c memos

[Desktop Action tasks]
_Name=Tasks
Exec=blueevolution -c tasks
